# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in every value before running the app.
# Never commit .env.local — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────

# Supabase dashboard → your project → Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Settings → API → "Project API keys" → anon / public
# Safe to expose to the browser; subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard → Settings → API → "Project API keys" → service_role
# Bypasses RLS — server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────

# console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=

# Primary classifier model. Change only to upgrade/downgrade.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI ────────────────────────────────────────────────────────────────────

# platform.openai.com → API Keys → Create new secret key
OPENAI_API_KEY=

# Fallback classifier model. Also used for Whisper + text-embedding-3-small.
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini

# ── Auth ──────────────────────────────────────────────────────────────────────

# Random 32-byte hex secret used to sign session cookies.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# The password shown on the /login page.
DASHBOARD_PASSWORD=

# Shared secret for programmatic API access (cron jobs, CLI, bots).
# Sent as the x-api-secret request header.
# Generate with: openssl rand -hex 32
API_SECRET=

# ── Telegram ──────────────────────────────────────────────────────────────────

# Message @BotFather on Telegram → /newbot → copy the token it returns.
TELEGRAM_BOT_TOKEN=

# Random secret registered with Telegram when setting the webhook URL so
# Telegram signs every request it sends you.
# Generate with: openssl rand -hex 32
# Then register: curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#   --data "url=https://your-domain.com/api/telegram/webhook" \
#   --data "secret_token=<this value>"
TELEGRAM_WEBHOOK_SECRET=

# Your personal numeric Telegram user ID — used to reject messages from
# anyone other than you. Send /start to @userinfobot to get your ID.
TELEGRAM_USER_ID=

# ── Google Calendar ───────────────────────────────────────────────────────────

# Google Calendar → Settings → pick a calendar → "Integrate calendar"
# → "Secret address in iCal format" (the long /feeds/…/private/basic.ics URL)
GOOGLE_CALENDAR_ICAL_URL=

# ── Google Sheets / Finance ───────────────────────────────────────────────────

# The spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_FINANCE_ID=

# ── Google Service Account ────────────────────────────────────────────────────

# Google Cloud Console → IAM & Admin → Service Accounts → create account →
# grant it "Viewer" on the relevant Sheets/Drive scope → copy the email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Google Cloud Console → Service Account → Keys → Add Key → JSON →
# then base64-encode the entire downloaded JSON file:
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────────

# Random secret sent by your cron provider (Vercel Cron, GitHub Actions, etc.)
# in the Authorization: Bearer <secret> header to authenticate scheduled calls.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── User / App ────────────────────────────────────────────────────────────────

# IANA timezone string for date calculations and log grouping.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
USER_TIMEZONE=Africa/Johannesburg

# Short identifier for the owner — used as a display name and DB tag.
USER_ID=dewald
